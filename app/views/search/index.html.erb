<% content_for :title, "Search" %>

<div class="page">
  <div class="page-title">Search</div>

  <%= form_with url: search_path, method: :get, class: "field" do |f| %>
    <%= f.text_field :q, value: @query, placeholder: "search your documents…" %>
    <div class="page-actions"><%= f.submit "Search", class: "btn" %></div>
  <% end %>

  <% if @result %>
    <% if @result.abstained? %>
      <p class="errors">No sufficiently relevant context found for “<%= @query %>”.</p>
    <% elsif @result.chunks.empty? %>
      <p class="empty-state">No results.</p>
    <% else %>
      <p class="page-sub"><strong><%= pluralize(@result.chunks.size, "result") %></strong> for “<%= @query %>”</p>
      <% @result.scored.each do |chunk, similarity| %>
        <div class="card result-card">
          <div class="meta">
            similarity <%= similarity ? format("%.3f", similarity) : "lexical only" %> ·
            <%= link_to chunk.document.title, document_path(chunk.document) %> ·
            #<%= chunk.position %>
          </div>
          <p><%= truncate(chunk.content, length: 300) %></p>
        </div>
      <% end %>
    <% end %>
  <% end %>
</div>
