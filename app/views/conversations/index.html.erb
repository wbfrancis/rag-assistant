<% content_for :title, "Chat" %>

<div class="page">
  <div class="page-title">Conversations</div>
  <div class="page-actions"><%= button_to "+ new conversation", conversations_path, method: :post, class: "btn" %></div>

  <% if @conversations.empty? %>
    <p class="empty-state">No conversations yet — start one above.</p>
  <% else %>
    <ul class="list-plain">
      <% @conversations.each do |conversation| %>
        <li>
          <%= link_to conversation.title.presence || "Untitled conversation", conversation %>
          <span class="meta"><%= conversation.created_at.to_fs(:short) %></span>
        </li>
      <% end %>
    </ul>
  <% end %>
</div>
