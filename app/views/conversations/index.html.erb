<% content_for :title, "Chat" %>
<h1>Chat</h1>

<p><%= link_to "← Documents", documents_path %> · <%= link_to "Search", search_path %></p>

<%= button_to "New conversation", conversations_path, method: :post %>

<% if @conversations.empty? %>
  <p style="margin-top: 1rem;">No conversations yet.</p>
<% else %>
  <ul style="margin-top: 1rem;">
    <% @conversations.each do |conversation| %>
      <li>
        <%= link_to conversation.title.presence || "Untitled conversation", conversation %>
        <small style="color: #888;"><%= conversation.created_at.to_fs(:short) %></small>
      </li>
    <% end %>
  </ul>
<% end %>
