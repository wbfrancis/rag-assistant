<% content_for :title, "Sign up" %>

<div class="page page--narrow">
  <div class="page-title">Sign up</div>

  <%= form_with model: @user, url: registration_path, method: :post do |f| %>
    <% if @user.errors.any? %>
      <ul class="errors">
        <% @user.errors.full_messages.each do |msg| %><li><%= msg %></li><% end %>
      </ul>
    <% end %>
    <div class="field">
      <%= f.label :email_address, "Email" %>
      <%= f.email_field :email_address, autofocus: true, autocomplete: "username" %>
    </div>
    <div class="field">
      <%= f.label :password %>
      <%= f.password_field :password, autocomplete: "new-password" %>
    </div>
    <div class="field">
      <%= f.label :password_confirmation, "Confirm password" %>
      <%= f.password_field :password_confirmation, autocomplete: "new-password" %>
    </div>
    <div class="page-actions"><%= f.submit "Sign up", class: "btn" %></div>
  <% end %>

  <p class="page-sub">Already have an account? <%= link_to "Sign in", new_session_path %></p>
</div>
