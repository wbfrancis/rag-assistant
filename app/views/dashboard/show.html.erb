<% content_for :title, "Usage" %>

<div class="page">
  <div class="page-title">Usage &amp; cost</div>
  <p class="page-sub">Token usage and derived cost for your account, computed from per-message token counts using current per-model prices (see <code>LlmPricing</code>).</p>

  <% summary = {
       "Conversations" => @conversation_count,
       "Answers" => @message_count,
       "Prompt tokens" => number_with_delimiter(@prompt_tokens),
       "Completion tokens" => number_with_delimiter(@completion_tokens),
       "Mean latency" => (@mean_latency_ms ? "#{number_with_delimiter(@mean_latency_ms)} ms" : "—"),
       "Est. cost" => "$#{format('%.4f', @total_cost)}"
     } %>
  <div class="stat-grid">
    <% summary.each do |label, value| %>
      <div class="card stat-tile">
        <div class="label"><%= label %></div>
        <div class="value"><%= value %></div>
      </div>
    <% end %>
  </div>

  <div class="section-title">Recent answers</div>
  <% if @recent.empty? %>
    <p class="empty-state">No answered questions yet. <%= link_to "Start a chat", conversations_path %>.</p>
  <% else %>
    <table class="table">
      <thead>
        <tr>
          <th>When</th><th>Model</th><th>Prompt</th><th>Completion</th><th>Latency</th><th>Cost</th><th></th>
        </tr>
      </thead>
      <tbody>
        <% @recent.each do |message| %>
          <tr>
            <td><%= message.created_at.strftime("%Y-%m-%d %H:%M") %></td>
            <td><%= message.model || "—" %></td>
            <td><%= number_with_delimiter(message.prompt_tokens) %></td>
            <td><%= number_with_delimiter(message.completion_tokens) %></td>
            <td><%= message.latency_ms ? "#{number_with_delimiter(message.latency_ms)} ms" : "—" %></td>
            <td><%= message.cost ? "$#{format('%.5f', message.cost)}" : "—" %></td>
            <td><%= link_to "view", conversation_path(message.conversation_id) %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  <% end %>
</div>
