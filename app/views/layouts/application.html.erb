<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "RAG Assistant — Will Francis" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="RAG Assistant">
    <meta name="description" content="A citation-grounded document assistant by Will Francis.">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <%# Enable PWA manifest for installable apps (make sure to enable in config/routes.rb too!) %>
    <%#= tag.link rel: "manifest", href: pwa_manifest_path(format: :json) %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Archivo:wght@400;500;600;700&family=IBM+Plex+Mono:wght@400;500;600&display=swap" rel="stylesheet">

    <%# Set the theme before first paint so there's no flash of the wrong theme. %>
    <script>
      (function () {
        var saved = null;
        try { saved = localStorage.getItem("theme"); } catch (e) {}
        document.documentElement.dataset.theme = saved === "light" ? "light" : "dark";
      })();
    </script>

    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body>
    <div class="app-shell">
      <header class="topbar">
        <%= link_to root_path, class: "topbar-brand" do %>rag<span class="dot">·</span>assistant<% end %>

        <% if current_user %>
          <nav class="topbar-nav">
            <%= link_to "chat", conversations_path, class: ("is-active" if controller_name == "conversations" || controller_name == "messages") %>
            <%= link_to "library", documents_path, class: ("is-active" if controller_name == "documents") %>
            <%= link_to "search", search_path, class: ("is-active" if controller_name == "search") %>
            <% unless demo_session? %>
              <%= link_to "usage", dashboard_path, class: ("is-active" if controller_name == "dashboard") %>
            <% end %>
          </nav>
        <% end %>

        <div class="topbar-right">
          <button type="button"
                  class="theme-toggle"
                  role="switch"
                  aria-checked="false"
                  aria-label="Use light theme"
                  data-controller="theme"
                  data-action="theme#toggle"
                  data-theme-state="dark">
            <span class="theme-toggle-thumb" aria-hidden="true"></span>
            <span class="theme-toggle-icon theme-toggle-moon" aria-hidden="true">
              <svg viewBox="0 0 16 16" focusable="false">
                <defs>
                  <mask id="theme-crescent-mask">
                    <rect width="16" height="16" fill="black"/>
                    <circle cx="8" cy="8" r="6.2" fill="white"/>
                    <circle cx="12" cy="7" r="4.7" fill="black"/>
                  </mask>
                </defs>
                <rect width="16" height="16" fill="currentColor" mask="url(#theme-crescent-mask)"/>
              </svg>
            </span>
            <span class="theme-toggle-icon theme-toggle-sun" aria-hidden="true">
              <svg viewBox="0 0 16 16" focusable="false">
                <circle cx="8" cy="8" r="2.5" fill="currentColor"/>
                <path d="M8 1v2M8 13v2M1 8h2M13 8h2M3.05 3.05l1.4 1.4M11.55 11.55l1.4 1.4M12.95 3.05l-1.4 1.4M4.45 11.55l-1.4 1.4"
                      fill="none" stroke="currentColor" stroke-width="1.25" stroke-linecap="round"/>
              </svg>
            </span>
          </button>

          <span class="topbar-user">
            <% if current_user %>
              <% unless demo_session? %><%= current_user.email_address %><% end %>
              <%= button_to demo_session? ? "end demo" : "sign out", session_path, method: :delete, form: { class: "link-button-form" }, class: "link-button" %>
            <% else %>
              <%= link_to "sign in", new_session_path %>
            <% end %>
          </span>
        </div>
      </header>

      <% if notice %><p class="flash flash-notice"><%= notice %></p><% end %>
      <% if alert %><p class="flash flash-alert"><%= alert %></p><% end %>

      <%= yield %>
    </div>
  </body>
</html>
