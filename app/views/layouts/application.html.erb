<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "Rag Assistant" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="Rag Assistant">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <%# Enable PWA manifest for installable apps (make sure to enable in config/routes.rb too!) %>
    <%#= tag.link rel: "manifest", href: pwa_manifest_path(format: :json) %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Archivo:wght@400;500;600;700&family=IBM+Plex+Mono:wght@400;500;600&display=swap" rel="stylesheet">

    <%# Set the theme before first paint so there's no flash of the wrong theme. %>
    <script>
      (function () {
        var saved = null;
        try { saved = localStorage.getItem("theme"); } catch (e) {}
        document.documentElement.dataset.theme = saved === "light" ? "light" : "dark";
      })();
    </script>

    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body>
    <div class="app-shell">
      <header class="topbar">
        <span class="topbar-brand">rag<span class="dot">·</span>assistant</span>

        <% if current_user %>
          <nav class="topbar-nav">
            <%= link_to "chat", conversations_path, class: ("is-active" if controller_name == "conversations" || controller_name == "messages") %>
            <%= link_to "library", documents_path, class: ("is-active" if controller_name == "documents") %>
            <%= link_to "search", search_path, class: ("is-active" if controller_name == "search") %>
            <%= link_to "usage", dashboard_path, class: ("is-active" if controller_name == "dashboard") %>
          </nav>
        <% end %>

        <div class="topbar-right">
          <button type="button" class="theme-toggle" data-controller="theme" data-action="theme#toggle" data-theme-target="label">☀ light</button>

          <span class="topbar-user">
            <% if current_user %>
              <%= current_user.email_address %>
              <%= button_to "sign out", session_path, method: :delete, form: { class: "link-button-form" }, class: "link-button" %>
            <% else %>
              <%= link_to "sign in", new_session_path %>
            <% end %>
          </span>
        </div>
      </header>

      <% if notice %><p class="flash flash-notice"><%= notice %></p><% end %>
      <% if alert %><p class="flash flash-alert"><%= alert %></p><% end %>

      <%= yield %>
    </div>
  </body>
</html>
