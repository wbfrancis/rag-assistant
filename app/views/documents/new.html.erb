<% content_for :title, "New document" %>

<div class="page">
  <%= turbo_frame_tag "doc_pane" do %>
    <div class="doc-toolbar">
      <%= link_to "← library", documents_path, class: "doc-back", data: { turbo_frame: "doc_pane" } %>
      <span class="doc-header">new document</span>
    </div>

    <div class="doc-scroll">
      <%= form_with model: @document, local: true, html: { multipart: true } do |f| %>
        <% if @document.errors.any? %>
          <ul class="errors">
            <% @document.errors.full_messages.each do |msg| %><li><%= msg %></li><% end %>
          </ul>
        <% end %>

        <div class="field">
          <%= f.label :title %>
          <%= f.text_field :title %>
        </div>

        <fieldset class="fieldset">
          <legend>Option A — upload a file (.txt, .md, .html, .pdf)</legend>
          <div class="field">
            <%= file_field_tag "document[file]", accept: ".txt,.md,.markdown,.html,.htm,.pdf" %>
          </div>
        </fieldset>

        <fieldset class="fieldset">
          <legend>Option B — paste text (Markdown)</legend>
          <div class="field">
            <%= text_area_tag "document[body]", nil, rows: 10 %>
          </div>
        </fieldset>

        <%= f.submit "Upload & ingest", class: "btn" %>
      <% end %>
    </div>
  <% end %>
</div>
