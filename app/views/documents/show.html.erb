<% content_for :title, @document.title %>

<% if @document.processing? || @document.pending? %>
  <%# Simple auto-refresh until ingestion finishes. Only takes effect on a full
      page load — a Turbo Frame navigation here ignores <head>, which is fine
      since that path is reached by clicking an already-ready document. %>
  <% content_for :head do %>
    <meta http-equiv="refresh" content="3">
  <% end %>
<% end %>

<div class="page">
  <%= turbo_frame_tag "doc_pane" do %>
    <%= render "documents/reader", document: @document, chunks: @chunks, active_chunk_id: @active_chunk_id, sim: @sim %>
  <% end %>
</div>
